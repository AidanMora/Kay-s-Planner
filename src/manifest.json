{
  "manifest_version": 3,
  "name": "Kay’s Planner",
  "version": "1.0.0",
  "description": "A companion task panel for Google Calendar that stages tasks independently and converts them into events on demand.",
  "action": {
    "default_title": "Kay’s Planner"
  },
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://calendar.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "549772460072-mujme46mr5dghc74p61a6625m0spican.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.events"]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ]
}